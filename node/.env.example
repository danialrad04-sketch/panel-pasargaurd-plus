SERVICE_PORT = 62050
# Host directory mounted at /var/lib/pg-node in the container.
PG_NODE_DATA_DIR = /var/lib/pg-node
NODE_HOST = "0.0.0.0"

# use absolute path

# XRAY_EXECUTABLE_PATH = /usr/local/bin/xray
# XRAY_ASSETS_PATH = /usr/local/share/xray
# The image ships Loyalsoldier/v2ray-rules-dat geoip.dat and geosite.dat in /usr/local/share/xray,
# pinned by GEOFILES_TAG in the Makefile (not the geo files from the Xray release zip).
# These are defaults: `pg-node geofiles` installs its own files and points XRAY_ASSETS_PATH at them.

SSL_CERT_FILE = /var/lib/pg-node/certs/ssl_cert.pem
SSL_KEY_FILE = /var/lib/pg-node/certs/ssl_key.pem

# api key must be a valid uuid (you can use any version you want)
API_KEY = xxxxxxxx-yyyy-zzzz-mmmm-aaaaaaaaaaa

### can be rest or grpc
# SERVICE_PROTOCOL = grpc

### developer options
# DEBUG = false
# GENERATED_CONFIG_PATH = /var/lib/pg-node/generated
# LOG_BUFFER_SIZE = 10000
# STARTUP_LOG_TAIL_SIZE = 200
# STATS_UPDATE_INTERVAL_SECONDS = 10
# STATS_CLEANUP_INTERVAL_SECONDS = 300

### WireGuard host NAT
### Built-in routing enables runtime IPv4 forwarding and manages scoped nft NAT/forwarding rules.
# PG_NODE_WG_HOST_ROUTING = 1
# PG_NODE_WG_NAT_OUTPUT_INTERFACE = eth0
# PG_NODE_WG_NAT_EGRESS_ONLY = 0
### Skip masquerade but keep forwarding rules (e.g. routing into an Xray TUN where Xray handles outbound).
# PG_NODE_WG_NAT_DISABLE = 0
### Optional policy routing: route only WireGuard ingress traffic out a target interface (e.g. xray0) via a dedicated table.
### Both must be set. The target interface must already exist (e.g. an Xray TUN you build yourself).
# PG_NODE_WG_ROUTE_TABLE = 100
# PG_NODE_WG_ROUTE_OUT_INTERFACE = xray0

### Native source-built Paqet extension (Linux; same certificate and API_KEY).
### Enabled by Dockerfile.plus; set true explicitly for a direct binary install.
# PG_NODE_PAQET_ENABLED = true
# PG_NODE_PAQET_PORT = 62052
# PG_NODE_PAQET_BINARY = /usr/local/bin/paqet
# PG_NODE_PAQET_STATE_DIR = /var/lib/pg-node/paqet
